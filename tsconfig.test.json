{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    // Tests may reach for Node APIs (filesystem scans in the convention guards)
    // and use Vitest globals. Application code deliberately may not.
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom/vitest"],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "e2e/**/*.ts"
  ],
  "exclude": []
}
